{
  "name": "tokiline",
  "version": "0.2.0",
  "description": "Framework-agnostic timeline UI: a CSS and HTML contract, TypeScript helpers, and optional React components.",
  "keywords": [
    "timeline",
    "css",
    "react",
    "nextjs",
    "server-components",
    "vertical-timeline"
  ],
  "author": "reeschan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeschan/tokiline.git"
  },
  "homepage": "https://reeschan.github.io/tokiline/",
  "bugs": {
    "url": "https://github.com/reeschan/tokiline/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./style.css": "./dist/style.css",
    "./presets/*.css": "./dist/presets/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:docker": "node scripts/e2e-docker.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm build && pnpm lint:package",
    "build": "pnpm build:js && pnpm build:css",
    "build:js": "tsdown",
    "build:css": "node scripts/build-css.ts",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "readme:images": "node scripts/readme-images.mjs",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "browserslist": "^4.29.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
